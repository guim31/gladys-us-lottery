{
  "manifest_version": 1,
  "type": "device",
  "name": "Powerball & Mega Millions",
  "description": {
    "en": "Powerball and Mega Millions numbers, next draws and your lines checked, for dashboards and scenes.",
    "fr": "Numéros du Powerball et du Mega Millions, prochains tirages et vos grilles vérifiées.",
    "de": "Gewinnzahlen von Powerball und Mega Millions, nächste Ziehungen und deine Tippreihen geprüft.",
    "es": "Números de Powerball y Mega Millions, próximos sorteos y sus jugadas comprobadas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-us-lottery:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-us-lottery/main/cover.png",
  "categories": ["leisure"],
  "countries": ["US"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "The winning numbers come from the open data of the State of New York (data.ny.gov): no account, no key. They are for information only, not an official result. After saving, add the Powerball and Mega Millions devices in the Discover tab.",
        "fr": "Les numéros gagnants viennent des données ouvertes de l'État de New York (data.ny.gov) : pas de compte, pas de clé. Ils sont indicatifs, pas un résultat officiel. Après l'enregistrement, ajoutez les appareils Powerball et Mega Millions dans l'onglet Découverte.",
        "de": "Die Gewinnzahlen stammen aus den offenen Daten des Bundesstaats New York (data.ny.gov): kein Konto, kein Schlüssel. Die Angaben sind nur informativ, kein amtliches Ergebnis. Füge nach dem Speichern die Geräte Powerball und Mega Millions im Tab „Entdecken“ hinzu.",
        "es": "Los números ganadores proceden de los datos abiertos del Estado de Nueva York (data.ny.gov): sin cuenta ni clave. Son solo informativos, no un resultado oficial. Después de guardar, añada los dispositivos Powerball y Mega Millions en la pestaña Descubrir."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-us-lottery#readme",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names and the sentences of the scenes. Names are set when a device is added.",
        "fr": "Noms des fonctionnalités et phrases des scènes. Les noms sont fixés à l'ajout d'un appareil.",
        "de": "Namen der Funktionen und Sätze der Szenen. Die Namen werden beim Hinzufügen eines Geräts festgelegt.",
        "es": "Nombres de las funciones y frases de las escenas. Los nombres se fijan al añadir un dispositivo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    },
    {
      "key": "powerball_grids",
      "type": "string",
      "label": {
        "en": "Your Powerball lines",
        "fr": "Vos grilles Powerball",
        "de": "Deine Powerball-Tippreihen",
        "es": "Sus jugadas de Powerball"
      },
      "description": {
        "en": "Optional. Your Powerball lines: 5 numbers from 1 to 69, then + and the Powerball from 1 to 26. Separate lines with a semicolon. Up to 10 lines.",
        "fr": "Facultatif. Vos grilles Powerball : 5 numéros de 1 à 69, puis + et le Powerball de 1 à 26. Séparez les grilles par un point-virgule. 10 grilles au plus.",
        "de": "Optional. Deine Powerball-Tippreihen: 5 Zahlen von 1 bis 69, dann + und der Powerball von 1 bis 26. Trenne die Tippreihen mit einem Semikolon. Höchstens 10.",
        "es": "Opcional. Sus jugadas de Powerball: 5 números del 1 al 69, luego + y el Powerball del 1 al 26. Separe las jugadas con un punto y coma. Hasta 10 jugadas."
      },
      "placeholder": {
        "en": "e.g. 5 12 23 34 45 + 6; 1 7 19 28 60 + 13",
        "fr": "ex. 5 12 23 34 45 + 6 ; 1 7 19 28 60 + 13",
        "de": "z. B. 5 12 23 34 45 + 6; 1 7 19 28 60 + 13",
        "es": "p. ej. 5 12 23 34 45 + 6; 1 7 19 28 60 + 13"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "mega_millions_grids",
      "type": "string",
      "label": {
        "en": "Your Mega Millions lines",
        "fr": "Vos grilles Mega Millions",
        "de": "Deine Mega-Millions-Tippreihen",
        "es": "Sus jugadas de Mega Millions"
      },
      "description": {
        "en": "Optional. Your Mega Millions lines: 5 numbers from 1 to 70, then + and the Mega Ball from 1 to 24. Separate lines with a semicolon. Up to 10 lines.",
        "fr": "Facultatif. Vos grilles Mega Millions : 5 numéros de 1 à 70, puis + et la Mega Ball de 1 à 24. Séparez les grilles par un point-virgule. 10 grilles au plus.",
        "de": "Optional. Deine Mega-Millions-Tippreihen: 5 Zahlen von 1 bis 70, dann + und der Mega Ball von 1 bis 24. Trenne die Tippreihen mit einem Semikolon. Höchstens 10.",
        "es": "Opcional. Sus jugadas de Mega Millions: 5 números del 1 al 70, luego + y la Mega Ball del 1 al 24. Separe las jugadas con un punto y coma. Hasta 10 jugadas."
      },
      "placeholder": {
        "en": "e.g. 3 14 27 41 66 + 9; 8 21 35 50 70 + 2",
        "fr": "ex. 3 14 27 41 66 + 9 ; 8 21 35 50 70 + 2",
        "de": "z. B. 3 14 27 41 66 + 9; 8 21 35 50 70 + 2",
        "es": "p. ej. 3 14 27 41 66 + 9; 8 21 35 50 70 + 2"
      },
      "required": false,
      "default": ""
    }
  ],
  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check",
        "fr": "Vérifier",
        "de": "Prüfen",
        "es": "Comprobar"
      },
      "description": {
        "en": "Reads data.ny.gov again now and shows the last draws, the next ones and your lines.",
        "fr": "Relit data.ny.gov maintenant et affiche les derniers tirages, les prochains et vos grilles.",
        "de": "Liest data.ny.gov jetzt neu und zeigt die letzten Ziehungen, die nächsten und deine Tippreihen.",
        "es": "Vuelve a leer data.ny.gov ahora y muestra los últimos sorteos, los próximos y sus jugadas."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "new_draw",
      "label": {
        "en": "New draw published",
        "fr": "Nouveau tirage publié",
        "de": "Neue Ziehung veröffentlicht",
        "es": "Nuevo sorteo publicado"
      },
      "description": {
        "en": "Fires when the numbers of a new draw are published, usually the morning after the draw (New York time).",
        "fr": "Se déclenche à la publication des numéros d'un nouveau tirage, en général le lendemain matin (heure de New York).",
        "de": "Löst aus, wenn die Zahlen einer neuen Ziehung veröffentlicht werden, meist am Morgen danach (Ortszeit New York).",
        "es": "Se activa cuando se publican los números de un nuevo sorteo, normalmente la mañana siguiente (hora de Nueva York)."
      },
